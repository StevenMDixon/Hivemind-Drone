# Minimal sway config: a kiosk compositor whose only job is to place each
# MPV station fullscreen on its own physical output.
#
# List connector names on the host with:
#   for p in /sys/class/drm/card*-*; do echo "$(basename $p) $(cat $p/status)"; done
# (strip the "cardN-" prefix, e.g. card0-HDMI-A-1 -> HDMI-A-1)

xwayland disable
default_border none
default_floating_border none
focus_follows_mouse no
seat * hide_cursor 1

# Optional: force modes, e.g. for composite/CRT outputs.
# output HDMI-A-1 mode 1920x1080@60Hz
# output HDMI-A-2 mode 1920x1080@60Hz
output * bg #000000 solid_color

workspace 1 output HDMI-A-1
workspace 2 output HDMI-A-2

# Station windows are matched by the --title set in settings.json mpvArgs.
for_window [title="^hivemind-station-1$"] move container to workspace 1, fullscreen enable
for_window [title="^hivemind-station-2$"] move container to workspace 2, fullscreen enable
